[customizations.installer.kickstart]
contents = """
text --non-interactive
lang en_US.UTF-8
keyboard us
timezone ${TIMEZONE} --utc

network --bootproto=dhcp --device=link --activate --onboot=on --hostname=${NODE_NAME}

zerombr
clearpart --all --initlabel --disklabel=gpt
part /boot/efi --fstype=efi   --size=512
part /boot     --fstype=xfs   --size=1024
part /         --fstype=xfs   --size=${ROOT_MINSIZE_MB} --grow

rootpw --lock
user --name=${USERNAME} --groups=wheel --password=${PASSWORD_HASH} --iscrypted

%post --erroronfail
mkdir -p /etc/flux
cat > /etc/flux/age.agekey <<'EOF'
${AGE_KEY}
EOF
chmod 0600 /etc/flux/age.agekey
restorecon -R /etc/flux || true
rm -f /var/log/anaconda/*ks*
%end
"""
