[Unit]
Description=K3s Kubernetes
Wants=network-online.target
After=network-online.target firewalld.service
RequiresMountsFor=/var/data

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p /var/lib/rancher/k3s/server/manifests
ExecStartPre=/usr/bin/cp -a /usr/share/k3s/manifests/. /var/lib/rancher/k3s/server/manifests/
ExecStart=/usr/bin/k3s server --config /etc/rancher/k3s/config.yaml
KillMode=process
Delegate=yes
Restart=always
RestartSec=5
TimeoutStartSec=0
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity

[Install]
WantedBy=multi-user.target
